NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key-here
SUPABASE_SECRET_KEY=sb_secret_your-key-here

# Optional: required only for embedding generation and map rendering.
HUGGINGFACE_API_KEY=hf_your_key_here
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-key
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_AUTOMATION_ENABLED=false

# Optional: dedicated system account UUID for retaining content on account deletion.
# LOSTOPEDIA_SYSTEM_USER_ID=<verified-system-user-uuid>

# Edge Function only: set a unique CRON_SECRET in the function's secret store.
# The scheduler sends it as Authorization: Bearer <secret>.

# Optional in local development. Recommended in production (Vercel Upstash integration names).
KV_REST_API_URL=https://your-redis-id.upstash.io
KV_REST_API_TOKEN=your-kv-rest-api-token

# Optional utility script keys
PIXABAY_API_KEY=your-pixabay-key
UNSPLASH_ACCESS_KEY=your-unsplash-access-key
